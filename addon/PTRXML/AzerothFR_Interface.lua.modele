-- Charge par Interface\PTRXML\PTR.xml, au tout debut des ecrans de connexion ET de l'interface en jeu.
-- Pour chaque texte d'interface : la valeur n'est remplacee par le francais QUE si elle vaut exactement
-- l'anglais attendu. Une cle absente de ce client, ou dont l'anglais a change, garde le texte du client.
-- Pour tout annuler : supprimer le dossier Interface\PTRXML.
local ok, err = pcall(function()
    local D = {
@DONNEES@
    }
    local G = _G
    local remplaces, ignores = 0, 0
    for i = 1, #D, 3 do
        local cle, en, fr = D[i], D[i + 1], D[i + 2]
        if G[cle] == en then
            G[cle] = fr
            remplaces = remplaces + 1
        else
            ignores = ignores + 1
        end
    end
    AzerothFR_Interface = { version = "@VERSION@", remplaces = remplaces, ignores = ignores }
end)
if not ok then
    AzerothFR_Interface = { version = "@VERSION@", erreur = tostring(err) }
end

-- ----------------------------------------------------------------------------------------------------------------
-- (0.4) Creation de personnage, ECRANS D'AVANT-JEU SEULEMENT (le GlueXML de CoA, patch-B, CharacterCreate.lua :
-- seul ce paquet y tourne). Les boutons des races (CharCreateRaceButtonN.Text, texte de GetAvailableRaces), des
-- classes (boutons de CharCreateClassFrame : nom de GetClassInfo, coupe en deux lignes par le client), les titres
-- des fiches (CharCreateRaceInfoFrame.title, CharCreateClassInfoFrame.title), la ligne « Race choisie » de la
-- navigation et le titre de l'infobulle (GlueTooltip) sont relus 5 fois par seconde tant que l'ecran est ouvert :
-- un texte qui vaut EXACTEMENT un nom anglais connu prend le nom francais (races : noms officiels de Blizzard,
-- ChrRaces frFR ; classes : noms de la source, feminin decide par Dan, point 17), selon le sexe choisi.
-- Affichage seulement : on ne change que le texte d'une zone de texte ; aucune variable ni fonction du jeu n'est
-- touchee. Tout est sous pcall ; a la premiere erreur, la relecture s'arrete pour la session (rien ne bloque
-- la connexion). En jeu, ce bloc ne fait rien. (0.9.4) Meme relecture pour l'ecran de SELECTION des personnages :
-- classe et zone de chaque carte (voir Selection plus bas).
-- (0.5) Noms de classes coupes (essai 4 : « Nécromancie… », « Pyromancien… », « Chronomanci… ») : la zone du nom
-- d'un bouton de classe a une largeur fixe (CharCreateClassButtonTemplate : 104 px, GameFontNormalSmall) et un mot
-- seul ne passe pas a la ligne. Si le texte pose ne tient pas (largeur mesuree comparee a GetWidth), la police de
-- CETTE zone seulement est reduite par paliers de 0,5 point, jamais sous 70 % de sa taille d'origine ; la taille
-- d'origine revient des que le texte de la zone change. Si le client change lui-meme la police (SetFontObject a
-- l'activation ou la desactivation du bouton), sa nouvelle taille devient l'origine.
-- ----------------------------------------------------------------------------------------------------------------
local ok2, err2 = pcall(function()
    if type(GetNumCharacters) ~= "function" or type(UnitName) == "function" or type(CreateFrame) ~= "function" then
        return                                      -- pas l'avant-jeu
    end
    local RACES = @RACES@
    local CLASSES = @CLASSES@
    local ZONES = @ZONES@
    local gsub, match, sub = string.gsub, string.match, string.sub
    local ecrits = setmetatable({}, { __mode = "k" })       -- zone -> { en = anglais, fr = francais pose }
    local n_poses = 0
    local tailles = setmetatable({}, { __mode = "k" })      -- (0.5) zone -> { police, taille, drapeaux, texte, posee }
    local n_reduits = 0
    local f = CreateFrame("Frame")
    local mesure                                            -- (0.5) zone de texte a nous, pour mesurer chaque ligne

    local function Femme()
        return type(GetSelectedSex) == "function" and GetSelectedSex() == 3
    end

    -- Nom francais d'un anglais exact (table { masculin, feminin }).
    local function Nom(t, en, f)
        local v = t[en]
        if type(v) ~= "table" then return nil end
        return (f and v[2]) or v[1]
    end

    -- Couleur exterieure eventuelle (« |cffxxxxxxCultist|r »).
    local function Enrobage(t)
        local c1, coeur, c2 = match(t, "^(|c%x%x%x%x%x%x%x%x)(.-)(|r)$")
        if coeur then return c1, coeur, c2 end
        return "", t, ""
    end

    -- Pose le francais dans une zone dont le texte est un nom anglais connu. coupe : le client coupe le nom
    -- de classe avant son dernier mot (« Witch\nDoctor ») ; on fait la meme coupe en francais.
    local function Poser(zone, t, coupe)
        if not zone or type(zone.GetText) ~= "function" then return end
        local texte = zone:GetText()
        if not texte or texte == "" then return end
        local e = ecrits[zone]
        local en = (e and texte == e.fr) and e.en or texte
        local c1, coeur, c2 = Enrobage(en)
        local cle = coupe and gsub(coeur, "\n", " ") or coeur
        local fr = Nom(t, cle, Femme())
        if not fr then return end
        if coupe and match(coeur, "\n") then fr = gsub(fr, " ([^ ]*)$", "\n%1", 1) end
        fr = c1 .. fr .. c2
        if fr ~= texte then
            zone:SetText(fr)
            n_poses = n_poses + 1
        end
        ecrits[zone] = { en = en, fr = fr }
    end

    -- (0.5) Largeur du texte : celle de la zone pour une ligne ; pour un nom coupe en deux lignes, la plus large des
    -- lignes, mesuree sur notre propre zone de texte a la meme police.
    local function Largeur(zone, texte, police, taille, drapeaux)
        if not string.find(texte, "\n", 1, true) then return zone:GetStringWidth() end
        if not mesure then
            mesure = f:CreateFontString(nil, "ARTWORK")
            mesure:Hide()
        end
        mesure:SetFont(police, taille, drapeaux)
        local w = 0
        for ligne in string.gmatch(texte, "[^\n]+") do
            mesure:SetText(ligne)
            local l = mesure:GetStringWidth() or 0
            if l > w then w = l end
        end
        return w
    end

    local function Ajuster(zone)
        if type(zone.GetFont) ~= "function" or type(zone.SetFont) ~= "function" or type(zone.GetWidth) ~= "function"
            or type(zone.GetStringWidth) ~= "function" then return end
        local texte = zone:GetText()
        if not texte or texte == "" then return end
        local police, taille, drapeaux = zone:GetFont()
        if type(police) ~= "string" or type(taille) ~= "number" or taille <= 0 then return end
        local t = tailles[zone]
        if t then
            if police ~= t.police or math.abs(taille - t.posee) > 0.01 then
                tailles[zone] = nil                         -- le client a change la police : nouvelle origine
            elseif texte ~= t.texte then
                zone:SetFont(t.police, t.taille, t.drapeaux)    -- le texte a change : taille d'origine
                taille = t.taille
                tailles[zone] = nil
            else
                return                                      -- deja ajustee pour ce texte
            end
        end
        local e = ecrits[zone]
        if not e or e.fr ~= texte then return end          -- seulement un nom francais pose par nous
        local largeur = zone:GetWidth()
        if type(largeur) ~= "number" or largeur <= 0 then return end
        if Largeur(zone, texte, police, taille, drapeaux) <= largeur + 0.5 then return end
        local origine, sz = taille, taille
        local mini = origine * 0.7
        while sz - 0.5 >= mini - 0.001 do
            sz = sz - 0.5
            zone:SetFont(police, sz, drapeaux)
            if Largeur(zone, texte, police, sz, drapeaux) <= largeur + 0.5 then break end
        end
        if sz < origine then
            tailles[zone] = { police = police, taille = origine, drapeaux = drapeaux, texte = texte, posee = sz }
            n_reduits = n_reduits + 1
        end
    end

    -- Boutons de classes : tous les boutons a cocher sous CharCreateClassFrame (lignes du client, guide des classes).
    local function Classes(cadre, profondeur)
        if not cadre or profondeur > 4 or type(cadre.GetChildren) ~= "function" then return end
        local enfants = { cadre:GetChildren() }
        for i = 1, #enfants do
            local b = enfants[i]
            if type(b) == "table" and b.Text and type(b.IsShown) == "function" and b:IsShown() then
                Poser(b.Text, CLASSES, true)
                Ajuster(b.Text)
            end
            Classes(b, profondeur + 1)
        end
    end

    -- Ligne de navigation « Race choisie : … » (RACE_SELECTED_TEXT, mise en forme par le client).
    local function Navigation(cadre)
        local modele = _G.RACE_SELECTED_TEXT
        if not cadre or type(modele) ~= "string" or type(cadre.GetChildren) ~= "function" then return end
        local avant, apres = match(modele, "^(.-)%%s(.*)$")
        if not avant then return end
        local enfants = { cadre:GetChildren() }
        for i = 1, #enfants do
            local b = enfants[i]
            local z = type(b) == "table" and type(b.GetFontString) == "function" and b:GetFontString() or nil
            local t = z and z:GetText()
            if t and sub(t, 1, #avant) == avant and sub(t, -#apres) == apres and #t > #avant + #apres then
                local milieu = sub(t, #avant + 1, #t - #apres)
                local fr = Nom(RACES, milieu, Femme())
                if fr and fr ~= milieu then
                    z:SetText(avant .. fr .. apres)
                    n_poses = n_poses + 1
                end
            end
        end
    end

    local function Passer()
        local cc = _G.CharacterCreate
        if type(cc) ~= "table" or type(cc.IsShown) ~= "function" or not cc:IsShown() then return end
        for i = 1, 20 do
            local b = _G["CharCreateRaceButton" .. i]
            if not b then break end
            if b.Text and b:IsShown() then Poser(b.Text, RACES, false) end
        end
        Classes(_G.CharCreateClassFrame, 0)
        local ri, ci = _G.CharCreateRaceInfoFrame, _G.CharCreateClassInfoFrame
        if type(ri) == "table" and ri.title then Poser(ri.title, RACES, false) end
        if type(ci) == "table" and ci.title then Poser(ci.title, CLASSES, false) end
        Navigation(_G.CharacterCreateNavigationFrame)
        local gt = _G.GlueTooltip
        if type(gt) == "table" and type(gt.IsShown) == "function" and gt:IsShown() then
            local l1 = _G.GlueTooltipTextLeft1
            if l1 then
                Poser(l1, RACES, false)
                Poser(l1, CLASSES, false)
            end
        end
    end

    -- (0.9.4) Ecran de SELECTION des personnages (essai 8, demande de Dan) : CharacterSelect.lua de CoA,
    -- CharacterSelectListItemMixin:Update ; chaque carte de la liste (CharacterSelectCharacterFrame.List, modele
    -- CharSelectScrollListItemTemplate) a Content.Info = format(CHARACTER_SELECT_INFO, niveau, classe en couleur)
    -- (« Stormbringer niveau 10 ») et Content.Location = la zone (GetCharacterInfo : nom de l'AreaTable du client,
    -- « Elwynn Forest »). Le nom anglais exact de la classe, pris dans GetCharacterInfo (ou dans la liste des
    -- personnages inactifs), est remplace dans le texte affiche par le nom francais selon le sexe du personnage ; la
    -- zone, si son texte est EXACTEMENT un nom anglais connu (un seul francais), prend le nom francais. Le nom du
    -- royaume reste celui du serveur.
    local function Feminin(sexe)
        if type(sexe) == "string" then return string.lower(sexe) == "female" end
        return sexe == 1 or sexe == 3                       -- 0/1 ou 2/3 selon l'API : 1 et 3 = femme
    end

    local function ClasseDans(zone, classeEN, femme)
        if not zone or type(zone.GetText) ~= "function" or type(classeEN) ~= "string" or classeEN == "" then return end
        local texte = zone:GetText()
        if not texte or texte == "" then return end
        local e = ecrits[zone]
        if e and texte == e.fr then return end
        local fr = Nom(CLASSES, classeEN, femme)
        if not fr or fr == classeEN then return end
        local d, fin = string.find(texte, classeEN, 1, true)
        if not d then return end
        local nouveau = sub(texte, 1, d - 1) .. fr .. sub(texte, fin + 1)
        zone:SetText(nouveau)
        n_poses = n_poses + 1
        ecrits[zone] = { en = texte, fr = nouveau }
    end

    local function ZoneDans(zone)
        if not zone or type(zone.GetText) ~= "function" then return end
        local texte = zone:GetText()
        local fr = texte and ZONES[texte]
        if type(fr) == "string" and fr ~= texte then
            zone:SetText(fr)
            n_poses = n_poses + 1
        end
    end

    local function Carte(b, inactifs)
        local c = b.Content
        if type(c) ~= "table" or type(b.index) ~= "number" then return end
        local classe, sexe
        if inactifs then
            local e = type(CharacterSelect.inactiveCharacters) == "table" and CharacterSelect.inactiveCharacters[b.index]
            if type(e) ~= "table" then return end
            classe = e.className or e.classLocalized or (type(e.class) == "string" and e.class) or nil
            sexe = e.sex or e.gender
        elseif type(GetCharIDFromIndex) == "function" and type(GetCharacterInfo) == "function" then
            local _, _, cl, _, _, sx = GetCharacterInfo(GetCharIDFromIndex(b.index))
            classe, sexe = cl, sx
        end
        if type(classe) == "string" then ClasseDans(c.Info, classe, Feminin(sexe)) end
        if not inactifs then ZoneDans(c.Location) end
    end

    local function Cartes(cadre, profondeur, inactifs)
        if not cadre or profondeur > 5 or type(cadre.GetChildren) ~= "function" then return end
        local enfants = { cadre:GetChildren() }
        for i = 1, #enfants do
            local b = enfants[i]
            if type(b) == "table" and type(b.IsShown) == "function" and b:IsShown() then
                if type(b.Content) == "table" and b.Content.Info then
                    Carte(b, inactifs)
                else
                    Cartes(b, profondeur + 1, inactifs)
                end
            end
        end
    end

    local function Selection()
        local cs = _G.CharacterSelect
        if type(cs) ~= "table" or type(cs.IsShown) ~= "function" or not cs:IsShown() then return end
        local cadre = _G.CharacterSelectCharacterFrame
        if type(cadre) ~= "table" or not cadre.List then return end
        Cartes(cadre.List, 0, cs.viewingInactiveList and true or false)
    end

    local cumul = 0
    f:SetScript("OnUpdate", function(self, ecoule)
        cumul = cumul + (ecoule or 0)
        if cumul < 0.2 then return end
        cumul = 0
        local bon, e = pcall(function() Passer(); Selection() end)
        if not bon then
            self:SetScript("OnUpdate", nil)          -- a la premiere erreur : on s'arrete (rien ne bloque l'ecran)
            if type(AzerothFR_Interface) == "table" then AzerothFR_Interface.erreur_creation = tostring(e) end
        elseif type(AzerothFR_Interface) == "table" then
            AzerothFR_Interface.creation_poses = n_poses
            AzerothFR_Interface.creation_reduits = n_reduits
        end
    end)
end)
if not ok2 and type(AzerothFR_Interface) == "table" then AzerothFR_Interface.erreur_creation = tostring(err2) end
